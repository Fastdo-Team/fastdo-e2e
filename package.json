{
  "name": "fastdo-test-auto",
  "version": "1.1.0",
  "private": true,
  "description": "Fastdo Fast & Visual QA Automation Test Runner",
  "main": "src/runner.js",
  "scripts": {
    "test": "node src/runner.js",
    "test:eval": "node src/runner.js",
    "test:auth": "node src/runner.js --auth-only",
    "e2e:dry": "node src/runner.js --nhap --headless",
    "aiqc": "node src/tools/aiqc.js",
    "drive:auth": "node src/tools/drive-auth.js",
    "test:unit": "node --test src/core/*.test.js src/sheets/*.test.js src/engine/*.test.js src/tools/*.test.js",
    "test:engine": "node --test --test-concurrency=1 src/engine/integration/*.test.js",
    "probe": "node src/tools/probe.js",
    "db:peek": "node src/tools/db-peek.js",
    "chrome:kill": "node src/tools/kill-stray-chrome.js",
    "smoke-test": "node .claude/skills/fastdo-eval-runner/scripts/smoke_test.js",
    "preflight": "node src/tools/preflight.js",
    "plan": "node src/tools/plan.js",
    "sheet:dump": "node src/tools/sheet-dump.js",
    "sheet:tabs": "node src/tools/sheet-tabs.js",
    "sheet:selftest": "node src/tools/sheet-selftest.js",
    "commit": "node src/tools/commit-result.js",
    "undo": "node src/tools/undo.js",
    "ui": "node src/tools/ui/server.js",
    "ui:run": "node src/tools/ui-run.js",
    "case": "node src/tools/case-info.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "form-data": "^4.0.0",
    "google-auth-library": "10.5.0",
    "mongodb": "7.6.0",
    "node-fetch": "^2.7.0",
    "playwright-core": "1.62.1",
    "puppeteer-core": "^25.0.0",
    "puppeteer-screen-recorder": "^3.0.6"
  }
}
