# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore, không commit.

# --- Tài khoản slot 1 (mặc định, dùng khi không truyền --account) ---
FASTDO_EMAIL=
FASTDO_PASSWORD=

# --- Tài khoản slot 2 (tuỳ chọn) — để 2 người/2 tài khoản chạy SONG SONG ---
# Chạy: npm test -- EVAL_022 --account=2 --round=3
# Slot 2 tự dùng Chrome riêng (cổng 9223), profile riêng (.chrome_profile_2) và
# file session riêng (.auth/user_state_2.json), nên không dẫm lên slot 1.
# Cần thêm slot 3 thì khai báo tiếp FASTDO_EMAIL_3 / FASTDO_PASSWORD_3.
FASTDO_EMAIL_2=
FASTDO_PASSWORD_2=

# Tổ chức phải chọn sau khi đăng nhập. Chỉ khai ORG_NAME_2 khi tài khoản slot 2
# thuộc tổ chức khác — bỏ trống thì slot 2 dùng chung ORG_NAME.
ORG_NAME=
# ORG_NAME_2=

# --- Dùng chung mọi slot ---
# Google Drive lưu video (thay Catbox — server Catbox chết 2026-10-22). KHÔNG điền tay: chạy
#     npm run drive:auth -- --client-file <file JSON OAuth client Desktop>
# lệnh tự ghi cả 4 biến (cách tạo OAuth client ở đầu src/tools/drive-auth.js). Video lên thư mục DRIVE_FOLDER_ID
# (do lệnh tạo — thư mục tạo tay app không thấy), mỗi video mở quyền «ai có link đều xem được».
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Dev tunnel có thể đổi theo thời gian — cập nhật khi tunnel hết hạn/đổi URL mới.
TARGET_URL=
SCALE_PAGE_URL=

SHEET_URL=
SHEET_ID=
SHEET_TAB=

# --- Google Sheets API (engine v2) ---
# File JSON key của service account (đường dẫn tương đối thì tính từ gốc repo).
# Share Sheet quyền Editor cho email "client_email" ghi trong file đó.
GOOGLE_SA_KEY_FILE=
# ID của tab = số sau "gid=" trên link Sheet. Khuyên dùng thay cho SHEET_TAB: không phụ
# thuộc tên tab, dấu cách cuối tên hay thứ tự tab. Có SHEET_GID thì SHEET_TAB chỉ để đối chiếu.
SHEET_GID=
# Nhãn cột "Môi trường" suy theo tên miền của TARGET_URL (hậu tố dài nhất thắng).
# Bỏ trống = mặc định dưới đây — khớp danh sách chọn Beta / Localhost / Production của Sheet.
# ENV_LABELS=devtunnels.ms=Localhost,localhost=Localhost,beta.fastdo.vn=Beta,fastdo.vn=Production
# Tên người duyệt, lưu vào nhật ký ghi Sheet (bỏ trống = tên user Windows).
# QC_NAME=

# Số khung hình/giây khi quay video (mặc định 15).
# Đây là đòn bẩy tốc độ lớn nhất: 30fps làm mỗi lần chạy chậm thêm ~19 giây.
# Chỉ tăng lên khi cần video mượt hơn để trình bày.
RECORD_FPS=15

# --- Giao diện QC (npm run ui) ---

# Cho phép nút trên trang tự khởi động Claude để viết kịch bản / chẩn đoán.
#   (bỏ trống hoặc không có dòng này) = CHẾ ĐỘ HÀNG ĐỢI — mặc định.
#       Trang chỉ ghi yêu cầu vào runs/.claude-queue.json kèm câu nhắc dựng sẵn,
#       QC chép dán vào phiên chat. Trang KHÔNG tự chạy gì.
#   CLAUDE_AUTO_RUN=1 = TỰ GỌI. Server spawn:
#       claude -p "<câu nhắc>" --permission-mode bypassPermissions
#
# Cân nhắc trước khi bật: một nút trên trang web sẽ khởi động được agent có quyền
# chạy lệnh trên máy này. Vì vậy công tắc CỐ Ý chỉ sửa được ở đây, không có nút
# nào trên trình duyệt bật được nó.
# CLAUDE_AUTO_RUN=1

# Model dùng khi chạy Claude từ trang. Để trống = dùng mặc định của Claude Code
# trên máy này. Nhận alias (opus, sonnet, haiku) hoặc tên đầy đủ (claude-opus-5).
# Đổi được luôn ở tab Cấu hình của giao diện.
# CLAUDE_MODEL=

# Cổng của giao diện (mặc định 7788). Bị chiếm thì đổi: UI_PORT=7799 npm run ui
# UI_PORT=7788

# Cổng CDP gốc của slot 1 (mặc định 9222). Slot N dùng cổng này + (N-1).
# Chỉ đổi khi 9222/9223 đã bị chương trình khác chiếm.
# CDP_PORT=9222

# --- Nhiều tài khoản Claude ("slot") ---
# Mỗi slot là một phiên đăng nhập Claude Code riêng, giữ song song. Hết hạn mức
# 5 tiếng ở slot này thì chạy tiếp bằng slot kia, không phải ngồi chờ tới giờ reset.
#   slot 1  = tài khoản Claude Code mặc định của máy (~/.claude) — dùng chung với
#             mọi chỗ khác, đăng xuất nó là ảnh hưởng ra ngoài repo này.
#   slot >=2 = thư mục riêng trong .claude-auth/ (đã gitignore), tách hoàn toàn.
# Đăng nhập bằng nút trên tab "Việc cho Claude" (mở cửa sổ `claude auth login`),
# hoặc chạy tay: set CLAUDE_CONFIG_DIR=<repo>\.claude-auth\slot2 && claude auth login
# CLAUDE_SLOTS=2

# Hết hạn mức thì tự chạy lại bằng slot còn đăng nhập. 0 = tắt. Mặc định bật.
# Đổi được ngay bằng ô tích trên tab "Việc cho Claude".
# CLAUDE_AUTO_SWITCH=1
